# Copy to .env.local and fill in. See SETUP.md for where each value comes from.

# Supabase project (Project Settings -> API). Also read at build time by
# next.config.ts, so set it before `npm run build`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: shared secret for the legacy Zoho SalesIQ webhook at
# /api/chatbot-leads. The on-site chatbot does not need it.
# CHATBOT_LEAD_SECRET=

# Optional: set to 1 to stop article views being counted (e.g. on preview
# deployments or while load-testing).
# SKIP_VIEW_COUNT=1
